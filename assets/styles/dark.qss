/* ============================================================
   ModeFlow – Dark Theme
   Fluent Design for Windows 11
   ============================================================ */

/* ── Theme Palette Guide ───────────────────────────────────
   Base text:                #e0e0e0
   Muted text:               #aaaaaa
   Regular icons:            rgba(214, 222, 228, 0.84)
   Active icon tint:         rgba(149, 189, 202, 0.96)
   Primary accent:           #6ca8ba
   Primary accent hover:     #7ab6c8
   Primary accent pressed:   #5a93a4
   Soft accent background:   rgba(108, 168, 186, 0.16)
   Disabled icon/text:       rgba(255, 255, 255, 0.4)

   Recommended usage:
   - New regular icons: use regular icons, not the accent, to avoid visual noise.
   - Active/important icons: use primary accent.
   - Hovered active icons: use primary accent hover.
   - Pressed active icons: use primary accent pressed.
   - Disabled icons: use disabled icon/text.
   - Selected backgrounds and focus accents: use primary accent or soft accent background.
*/

/* ── 1. Global & Windows ──────────────────────────────────── */
QDialog,
QFileDialog {
    background-color: rgb(28, 28, 28);
}

QMessageBox {
    background-color: rgba(30, 30, 30, 0.9);
}

QWidget {
    background-color: transparent;
    color: #e0e0e0;
}

QLabel {
    color: #e0e0e0;
}

QToolTip {
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QSizeGrip {
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
}

QSizeGrip:hover {
    background-color: rgba(108, 168, 186, 0.16);
    border: 1px solid rgba(108, 168, 186, 0.34);
}

QSizeGrip:pressed {
    background-color: rgba(108, 168, 186, 0.24);
    border: 1px solid rgba(108, 168, 186, 0.46);
}

QStatusBar {
    background-color: #1c1c1c;
    color: rgba(255, 255, 255, 0.5);
    border-top: 1px solid rgba(32, 32, 32, 0.8);
}

/* ── 2. Buttons ───────────────────────────────────────────── */
QPushButton {
    background-color: rgba(32, 32, 32, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.16);
    color: #e0e0e0;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.2);
}

QPushButton:focus {
    border-color: rgba(108, 168, 186, 0.34);
    border-bottom-color: rgba(108, 168, 186, 0.55);
    background-color: rgba(255, 255, 255, 0.08);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(32, 32, 32, 0.8);
    border-bottom-color: rgba(255, 255, 255, 0.1);
}

QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.28);
}

QPushButton:default {
    background-color: #6ca8ba;
    border: 1px solid #6ca8ba;
    color: #0d1e21;
    font-weight: 600;
}

QPushButton:default:hover {
    background-color: #7ab6c8;
    border-color: #7ab6c8;
    color: #0d1e21;
}

QPushButton:default:pressed {
    background-color: #5a93a4;
    border-color: #5a93a4;
    color: #0d1e21;
}

QPushButton:default:disabled {
    background-color: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.04);
    color: rgba(255, 255, 255, 0.28);
}

QToolButton {
    margin: 2px;
}

QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.2);
}

QToolButton:focus {
    background-color: rgba(108, 168, 186, 0.14);
    border: 1px solid rgba(108, 168, 186, 0.5);
}

QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.03);
}

QToolButton#btnSettings:hover,
QToolButton#btnAbout:hover,
QToolButton#btnProfileIcon:hover,
QToolButton#btnBrowse:hover {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
}

QToolButton#btnSettings:focus,
QToolButton#btnAbout:focus,
QToolButton#btnProfileIcon:focus,
QToolButton#btnBrowse:focus {
    background: rgba(108, 168, 186, 0.14);
    border: 1px solid rgba(108, 168, 186, 0.5);
    border-radius: 6px;
}

QToolButton#btnProfileIcon,
QToolButton#btnBrowse {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

/* ── 3. Input & Choice Controls ───────────────────────────── */
QLineEdit,
QTextEdit,
QKeySequenceEdit,
QSpinBox {
    background-color: rgba(0, 0, 0, 0.2);
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.16);
    selection-background-color: #6ca8ba;
    selection-color: #08151a;
}

QLineEdit:hover,
QTextEdit:hover,
QSpinBox:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QLineEdit:focus,
QTextEdit:focus,
QKeySequenceEdit:focus,
QSpinBox:focus {
    border-color: #6ca8ba;
}

QLineEdit:focus,
QTextEdit:focus {
    background-color: rgba(0, 0, 0, 0.25);
}

QLineEdit:read-only,
QTextEdit:read-only {
    background-color: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.4);
    border-color: rgba(255, 255, 255, 0.05);
}

QLineEdit:disabled,
QTextEdit:disabled,
QSpinBox:disabled {
    color: rgba(255, 255, 255, 0.28);
    background-color: rgba(255, 255, 255, 0.03);
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background-color: rgba(255, 255, 255, 0.05);
}

QSpinBox::up-arrow {
    border-bottom: 5px solid rgba(255, 255, 255, 0.65);
}

QSpinBox::down-arrow {
    border-top: 5px solid rgba(255, 255, 255, 0.65);
}

QSpinBox::up-arrow:disabled,
QSpinBox::down-arrow:disabled {
    border-bottom-color: rgba(255, 255, 255, 0.22);
    border-top-color: rgba(255, 255, 255, 0.22);
}

QComboBox {
    background-color: rgba(32, 32, 32, 0.8);
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom-color: rgba(255, 255, 255, 0.16);
}

QComboBox:hover {
    background-color: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.18);
}

QComboBox:focus {
    border-color: #6ca8ba;
}

QComboBox:disabled {
    color: rgba(255, 255, 255, 0.28);
    background-color: rgba(255, 255, 255, 0.03);
}

QComboBox::down-arrow {
    border-top: 5px solid rgba(255, 255, 255, 0.65);
}

QComboBox::down-arrow:disabled {
    border-top-color: rgba(255, 255, 255, 0.22);
}

QComboBox QAbstractItemView {
    background-color: rgba(32, 32, 32, 0.85);
    color: #e0e0e0;
    border: 1px solid rgba(255, 255, 255, 0.1);
    selection-background-color: rgba(108, 168, 186, 0.2);
    selection-color: #e7f1f4;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 0.07);
}

QComboBox QAbstractItemView::item:selected {
    background-color: rgba(108, 168, 186, 0.2);
    color: #e7f1f4;
}

QCheckBox {
    color: #e8e8e8;
}

QCheckBox::indicator {
    border: 1px solid #697381;
    background-color: rgba(255, 255, 255, 0.07);
}

QCheckBox::indicator:hover {
    border: 1px solid #6ca8ba;
    background-color: #24353c;
}

QCheckBox::indicator:pressed {
    border: 1px solid #5a93a4;
    background-color: #2b4048;
}

QCheckBox::indicator:checked {
    border: 1px solid #6ca8ba;
    background-color: #6ca8ba;
}

QCheckBox::indicator:checked:hover {
    border: 1px solid #7ab6c8;
    background-color: #7ab6c8;
}

QCheckBox::indicator:checked:pressed {
    border: 1px solid #5a93a4;
    background-color: #5a93a4;
}

QCheckBox::indicator:disabled {
    border: 1px solid #4e5561;
    background-color: #2a2f37;
}

QCheckBox::indicator:checked:disabled {
    border: 1px solid #5e6878;
    background-color: #5e6878;
}

/* ── 4. Lists, Tabs & Scrollbars ──────────────────────────── */
QTabWidget::pane {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background-color: #252525;
    border-radius: 8px;
}

QTabBar::tab {
    color: rgba(255, 255, 255, 0.55);
}

QTabBar::tab:selected {
    color: #e0e0e0;
    border-bottom: 2px solid #6ca8ba;
}

QTabBar::tab:hover:!selected {
    background: rgba(32, 32, 32, 0.8);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 4px 4px 0 0;
}

QListView {
    background-color: rgba(0, 0, 0, 0.15);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 10px;
}

QListWidget {
    background-color: rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
}

QListWidget::item {
    color: #aaaaaa;
    padding: 4px 8px;
}

QListWidget::item:selected {
    background-color: rgba(108, 168, 186, 0.16);
    color: #eef4f6;
}

QListWidget::item:hover:!selected {
    background-color: rgba(255, 255, 255, 0.07);
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.18);
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.38);
}

QScrollBar::handle:vertical:pressed,
QScrollBar::handle:horizontal:pressed {
    background: rgba(255, 255, 255, 0.55);
}

QPlainTextEdit {
    background-color: rgba(0, 0, 0, 0.3);
    color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.1);
    selection-background-color: #6ca8ba;
    selection-color: #08151a;
}

QPlainTextEdit:focus {
    border-color: rgba(108, 168, 186, 0.68);
}

/* ── 5. Containers & Menus ────────────────────────────────── */
QGroupBox {
    background-color: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    margin-top: 24px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 4px;
    top: 4px;
    font-weight: 600;
    font-size: 9.5pt;
    color: rgba(255, 255, 255, 0.9);
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: rgba(255, 255, 255, 0.1);
    background-color: rgba(255, 255, 255, 0.1);
}

QMenu {
    background-color: #2c2c2c;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QMenu::item {
    color: #e0e0e0;
}

QMenu::item:selected {
    background-color: rgba(255, 255, 255, 0.1);
}

QMenu::item:disabled {
    color: rgba(255, 255, 255, 0.4);
}

QMenu::item:pressed {
    background-color: rgba(255, 255, 255, 0.05);
}

QMenu::separator {
    background: rgba(255, 255, 255, 0.1);
}

QMenu#profileIconMenu,
QMenu#moreMenu {
    background-color: rgba(30, 30, 30, 0.96);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QToolButton#profileIconOption {
    background-color: transparent;
    border: 1px solid transparent;
}

QToolButton#profileIconOption:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QToolButton#profileIconOption:pressed {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
}

QToolButton#profileIconOption[selected="true"] {
    background-color: rgba(108, 168, 186, 0.16);
    border: 1px solid rgba(108, 168, 186, 0.42);
}

/* ── 6. StyleBridge Property Provider ─────────────────────── */
#styleBridge {
    qproperty-iconprefix: ":/icons/dark";
    qproperty-iconnormal: rgba(214, 222, 228, 0.84);
    qproperty-iconactive: rgba(149, 189, 202, 0.96);
    qproperty-icondisabled: rgba(255, 255, 255, 0.4);
    qproperty-iconbadge: #FF9800;
    qproperty-sidebaritemhoverbg: rgba(255, 255, 255, 0.07);
    qproperty-sidebaritemselectedbg: rgba(108, 168, 186, 0.16);
    qproperty-sidebartextnormal: #aaaaaa;
    qproperty-sidebartextselected: #eef4f6;
    qproperty-sidebaraccent: #6ca8ba;
    /* LogViewer colors */
    qproperty-logtimestamp: #808080;
    qproperty-logcategory: #64B4FF;
    qproperty-logfunction: #B4B464;
    qproperty-logdebug: #888888;
    qproperty-loginfo: #4CAF50;
    qproperty-logwarning: #FF9800;
    qproperty-logcritical: #F44336;
    qproperty-logfatal: #B71C1C;
}

/* ── 7. Component-Specific Styles ─────────────────────────── */

/* MainWindow */
#MainWindow QPushButton#btnCapture,
#MainWindow QPushButton#btnGithub,
#MainWindow QPushButton#btnNewVersion,
#MainWindow QPushButton#btnLicenses {
    color: rgba(149, 189, 202, 0.88);
}

#MainWindow QPushButton#btnCapture:hover,
#MainWindow QPushButton#btnGithub:hover,
#MainWindow QPushButton#btnNewVersion:hover,
#MainWindow QPushButton#btnLicenses:hover {
    color: rgba(180, 210, 220, 0.96);
}

#MainWindow QPushButton#btnCreateProfile {
    background-color: rgba(0, 0, 0, 0.15);
    color: rgba(255, 255, 255, 0.5);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

#MainWindow QPushButton#btnCreateProfile:hover {
    background-color: rgba(255, 255, 255, 0.07);
    color: #eef4f6;
}

#MainWindow QToolButton#btnMore[hasUpdate="true"] {
    background-color: rgba(255, 152, 0, 0.14);
    border: 1px solid rgba(255, 152, 0, 0.45);
    border-radius: 6px;
}

#MainWindow QToolButton#btnMore[hasUpdate="true"]:hover {
    background-color: rgba(255, 152, 0, 0.25);
    border-color: rgba(255, 152, 0, 0.7);
}

/* Row Widgets */
QWidget#profileRowWidget QToolButton#btnDeleteProfileInline,
QWidget#appRowWidget QToolButton#btnDeleteAppInline {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: 4px;
    padding: 0;
    margin: 0;
}

QWidget#profileRowWidget QToolButton#btnDeleteProfileInline:hover,
QWidget#appRowWidget QToolButton#btnDeleteAppInline:hover {
    background-color: rgba(244, 67, 54, 0.18);
    border: 1px solid rgba(244, 67, 54, 0.35);
}

/* AboutDialog */
#AboutDialog QLabel#labelIcon {
    image: url(:/icons/dark/icon.svg);
}

#AboutDialog QLabel#labelTitle {
    color: #ffffff;
}

#AboutDialog QLabel#labelVersion,
#AboutDialog QLabel#labelDescription {
    color: rgba(255, 255, 255, 0.7);
}

#AboutDialog QLabel#labelDisclaimer {
    color: rgba(255, 255, 255, 0.4);
}

/* UpdateDialog */
QFrame#versionCardFrame {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
}

#UpdateDialog QLabel#titleLabel {
    font-size: 14pt;
    font-weight: 600;
    color: #ffffff;
}

#UpdateDialog QLabel#subtitleLabel {
    font-size: 9.5pt;
    color: rgba(255, 255, 255, 0.6);
}

#UpdateDialog QLabel#labelCurrentVersion {
    font-size: 9.5pt;
    color: rgba(255, 255, 255, 0.7);
}

#UpdateDialog QLabel#labelArrow,
#UpdateDialog QLabel#labelNewVersion {
    font-size: 9.5pt;
    font-weight: 600;
    color: #6ca8ba;
}

#UpdateDialog QPushButton#skipBtn {
    background: transparent;
    border: none;
    padding: 0;
    margin: 0;
    text-align: left;
    text-decoration: none;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
}

#UpdateDialog QPushButton#skipBtn:hover {
    color: rgba(255, 255, 255, 0.85);
    text-decoration: underline;
}

/* LogViewerDialog */
QToolButton#btnFollow:checked {
    background-color: rgba(108, 168, 186, 0.16);
    border: 1px solid rgba(108, 168, 186, 0.34);
}

#btnRecordLog {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background-color: rgba(255, 255, 255, 0.02);
    border-radius: 4px;
}

#btnRecordLog:checked {
    color: #f44336;
    border-color: rgba(244, 67, 54, 0.35);
    background-color: rgba(244, 67, 54, 0.12);
}

#btnRecordLog:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

QLabel#labelEmptyIcon {
    font-family: "Font Awesome 7 Free";
    color: rgba(255, 255, 255, 0.25);
}

QLabel#labelEmptyTitle {
    font-size: 11pt;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
}

QLabel#labelEmptyDesc {
    font-size: 9.5pt;
    color: rgba(255, 255, 255, 0.55);
}

/* QFileDialog */
QFileDialog QTreeView,
QFileDialog QListView {
    background-color: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    color: #e0e0e0;
}

QFileDialog QAbstractItemView,
QFileDialog QComboBox QAbstractItemView {
    background-color: #2c2c2c !important;
    color: #e0e0e0 !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
}

QFileDialog QAbstractItemView::item:selected {
    background-color: rgba(108, 168, 186, 0.2) !important;
    color: #e7f1f4 !important;
}
