      </item>
      <item row="1" column="0" colspan="2">
       <layout class="QHBoxLayout" name="horizontalLayout_4" stretch="0,10">
        <item>
         <widget class="QLabel" name="label_delay">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Sets a pause before automatically applying settings upon Windows logon. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Tip&lt;/span&gt;: &lt;span style=&quot; font-style:italic;&quot;&gt;Drivers for monitors and audio cards take time to load. If the startup profile doesn't apply correctly, try increasing this delay.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Logon delay:</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QSpinBox" name="spinLogonDelay">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Sets a pause before automatically applying settings upon Windows logon. &lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-weight:700;&quot;&gt;Tip&lt;/span&gt;: &lt;span style=&quot; font-style:italic;&quot;&gt;Drivers for monitors and audio cards take time to load. If the startup profile doesn't apply correctly, try increasing this delay.&lt;/span&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="suffix">
           <string> sec</string>
          </property>
          <property name="maximum">
           <number>30</number>
          </property>
          <property name="value">
           <number>3</number>
          </property>
         </widget>
        </item>
       </layout>
      </item>
     </layout>
    </widget>
   </item>
