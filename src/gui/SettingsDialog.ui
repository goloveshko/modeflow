     </property>
     <layout class="QFormLayout" name="formLayout_1">
      <item row="0" column="0">
       <widget class="QCheckBox" name="checkAutostart">
        <property name="toolTip">
         <string>Administrative privileges are required to modify the system task scheduler.</string>
        </property>
        <property name="text">
         <string>Start ModeFlow with Windows</string>
        </property>
